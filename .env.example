# Copiá este archivo a .env y completá tus claves: cp .env.example .env

# --- API keys (al menos una) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- Proveedor por defecto: openai | anthropic ---
LLM_PROVIDER=openai

# --- Modelos (opcionales; si se omiten se usan los defaults del código) ---
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Parámetros del modelo (opcionales, validados con Pydantic) ---
# temperature: 0 a 2 en OpenAI, 0 a 1 en Anthropic
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
# Timeout por request, en segundos
LLM_TIMEOUT=60
# Reintentos ante rate limit, timeouts, errores de red y 5xx
LLM_MAX_RETRIES=3
